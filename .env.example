# NST-Bot environment
#
# Copy this file to .env and fill in the real values:
#     cp .env.example .env
#
# .env is gitignored — never commit it, and never paste these values into Discord.
# Only secrets and per-deployment values live here. Server constants (role names,
# channel names, command prefix) live in config.py instead.


# --- Discord -----------------------------------------------------------------
# Discord Developer Portal -> your application -> Bot -> Reset Token.
# The bot also needs the "Message Content" and "Server Members" privileged
# intents enabled on that same page, or main.py will fail to connect.
DISCORD_TOKEN=


# --- MongoDB -----------------------------------------------------------------
# Atlas: Database -> Connect -> Drivers -> Python. Include the password inline.
# The database name is hardcoded to "nst_bot" in db.py, so it does not need to
# be part of the URI.
# Local example:  mongodb://localhost:27017
# Atlas example:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=


# --- Groq (AI help desk) -----------------------------------------------------
# https://console.groq.com/keys
# Only the !ask / mention help desk uses this. Verification, moderation and
# batch commands all work without it.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile if left blank.
GROQ_MODEL=llama-3.3-70b-versatile
